# Required. For Supabase use the *Session pooler* string from Connect (IPv4; the
# direct db.<ref>.supabase.co host is IPv6-only). Percent-encode special
# characters in the password.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# CA certificate that verifies the database's TLS certificate and hostname: a
# path (relative to the working directory) or PEM text. The repo ships
# Supabase's public root CA; leave empty for databases with publicly trusted certs.
DATABASE_CA_CERT=certs/supabase-prod-ca-2021.crt

# HTTP
PORT=3000
LOG_LEVEL=info
# Set to require an HMAC-SHA256 hex signature of the raw body in X-Webhook-Signature (or X-Razorpay-Signature).
WEBHOOK_SECRET=
# Max wait for the database before answering 503 so the sender retries (keeps us inside the 500ms SLA).
WEBHOOK_DB_TIMEOUT_MS=450

# Database connections. API + worker must stay below the pooler's pool size
# (Supabase: Database Settings > Connection pooling, ~15 on the free plan).
API_POOL_SIZE=10
WORKER_POOL_SIZE=3

# Background processing
WORKER_ENABLED=true
WORKER_CONCURRENCY=100
PROCESSING_DELAY_MS=30000
PROCESSING_TIMEOUT_MS=60000
LEASE_MS=120000
MAX_ATTEMPTS=5
RETRY_BASE_MS=5000
RETRY_MAX_MS=300000
# Fraction (0-1) of attempts that fail on purpose, to demo retries.
SIMULATED_FAILURE_RATE=0
